# Which model the agent uses (see config/models.json). Switching model or provider = edit these two lines.
#   gemini_native / gemini-3.5-flash-lite   default: Google's SDK (honours seed)
#   gemini        / gemini-3.5-flash-lite   Gemini's OpenAI-compatible endpoint
#   gemini_native / gemma-4-26b-a4b-it      Gemma 4 (honours temperature and top_p)
#   ollama_native / qwen3:8b                local model through Ollama (no key; ollama pull qwen3:8b)
#   openai        / <model id>              add the model to config/models.json, then run scripts/probe_settings.py
LLM_PROVIDER=gemini_native
LLM_MODEL=gemini-3.5-flash-lite

GEMINI_API_KEY=your-key-here
OPENAI_API_KEY=
